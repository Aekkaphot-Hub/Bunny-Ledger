rules_version = '2';
// Bunny Ledger: เจ้าของบัญชีอ่าน/เขียนได้เฉพาะข้อมูลของตัวเองเท่านั้น
//   users/{uid}/{collection}/{docId}                       ← ร้านแรก (ร้านหลัก)
//   users/{uid}/shops/{shopId}                             ← รายชื่อร้านที่เจ้าของบัญชีสร้าง
//   users/{uid}/shops/{shopId}/{collection}/{docId}        ← ข้อมูลของร้านที่สร้างเพิ่ม
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isDataCollection(c) {
      return c in ['orders', 'expenses', 'otherIncome', 'imports', 'settings', 'templates'];
    }
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if isOwner(uid) && isDataCollection(collection);
    }
    match /users/{uid}/shops/{shopId} {
      allow read, write: if isOwner(uid);
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && isDataCollection(collection);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
