rules_version = '2';
// Bunny Ledger — กฎความปลอดภัย (บังคับสิทธิ์ที่ฝั่งเซิร์ฟเวอร์ของ Firebase)
//   users/{uid}/{collection}/{docId}                 ← ข้อมูลร้านแรกของเจ้าของบัญชี
//   users/{uid}/shops/{shopId}                       ← รายชื่อร้าน + สมาชิก { members: { "อีเมล": "manager" | "staff" } }
//   users/{uid}/shops/{shopId}/{collection}/{docId}  ← ข้อมูลร้านที่สร้างเพิ่ม
//   invites/{อีเมล}/shops/{ownerUid_shopId}            ← คำเชิญ ให้คนที่ได้รับเชิญเห็นร้านในรายการ
// สิทธิ์: เจ้าของ = ทุกอย่าง • ผู้จัดการ = เห็น/แก้ข้อมูลร้านทุกอย่าง (จัดการทีมไม่ได้)
//        พนักงาน = ออเดอร์ การนำเข้าไฟล์ ติดตามพัสดุ (ไม่เห็นรายจ่าย รายรับอื่น กำไร แก้การตั้งค่าร้านไม่ได้)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // เปิดสมัครบัญชีเองได้ → สิทธิ์ที่ผูกกับอีเมล (ร้านที่ได้รับเชิญ) ใช้ได้เฉพาะอีเมลที่ยืนยันแล้ว กันคนสมัครด้วยอีเมลของคนอื่น
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isDataCollection(c) {
      return c in ['orders', 'expenses', 'otherIncome', 'imports', 'settings', 'templates', 'products', 'deposits', 'invoices'];
    }
    // บทบาทของผู้ใช้ในร้านของคนอื่น ('' = ไม่ใช่สมาชิก)
    function roleIn(uid, shopId) {
      let path = /databases/$(database)/documents/users/$(uid)/shops/$(shopId);
      return exists(path) ? get(path).data.get('members', {}).get(myEmail(), '') : '';
    }
    function memberCan(uid, shopId, c, write) {
      return verified() && isDataCollection(c)
        && (roleIn(uid, shopId) == 'manager'
          || (roleIn(uid, shopId) == 'staff'
            && c in (write ? ['orders', 'imports', 'templates', 'otherIncome'] : ['orders', 'imports', 'templates', 'settings'])));
    }

    match /users/{uid}/{collection}/{docId} {
      allow read: if (isOwner(uid) && isDataCollection(collection)) || memberCan(uid, 'main', collection, false);
      allow write: if (isOwner(uid) && isDataCollection(collection)) || memberCan(uid, 'main', collection, true);
    }
    match /users/{uid}/shops/{shopId} {
      allow read: if isOwner(uid)
        || (verified() && resource.data.get('members', {}).get(myEmail(), '') != '');
      allow write: if isOwner(uid);
      match /{collection}/{docId} {
        allow read: if (isOwner(uid) && isDataCollection(collection)) || memberCan(uid, shopId, collection, false);
        allow write: if (isOwner(uid) && isDataCollection(collection)) || memberCan(uid, shopId, collection, true);
      }
    }
    match /invites/{email}/shops/{inviteId} {
      allow read: if verified() && myEmail() == email;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && inviteId.matches(request.auth.uid + '_.+');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
